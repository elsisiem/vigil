# Copy to .env and fill in. Never commit .env.
YDC_API_KEY=""                 # You.com: https://you.com/platform/api-keys (Search, Contents, Research)
PARASAIL_API_KEY=""            # Parasail: https://saas.parasail.io/keys (inference + embeddings)
PARASAIL_BASE_URL="https://api.parasail.io/v1"
ONE_SECRET=""                  # One: app.withone.ai -> Settings -> API keys (used for the after-action GitHub issue)
GITHUB_REPO="owner/repo"       # where One files post-incident review issues
TEAM_HANDLE="team-yourname"    # lowercase, dashes; prefixes every dispatch and feed submission
SCENARIO_MCP="https://api.you.com/mcp/halloween-hack-26"
DISCORD_WEBHOOK_URL=""         # venue webhook from the organizers' guide (section 3.4)
DISCORD_CHANNEL_ID="1564842098740695100"
VIGIL_DRY_RUN="1"              # 1 = log actions instead of posting/submitting; 0 = live
VIGIL_OFFLINE="0"              # 1 = serve cached responses only (replays still work with no keys at all)
VIGIL_DELIBERATE="0"           # 1 = let the commander model think longer before deciding
# VIGIL_NODE_BIN="C:/path/to/node22/bin"   # only if Node 22+ is not on PATH (the One CLI requires it)
# VIGIL_MODEL_FAST="parasail-deepseek-v41-flash"
# VIGIL_MODEL_AGENT="parasail-minimax-m31-flash"
# VIGIL_MODEL_COMMANDER="parasail-kimi-k3"
# VIGIL_MODEL_EMBED="parasail-bge-m3"
